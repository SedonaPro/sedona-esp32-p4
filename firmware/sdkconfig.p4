# ESP32-P4 bring-up. Board network pins are not assumed.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
# CONFIG_SEDONA_NET_NONE is not set
CONFIG_SEDONA_NET_P4_ETH=y

# CONFIG_SEDONA_COMPUTED_GOTO is not set

# CONFIG_SEDONA_VM_O3 is not set

CONFIG_SEDONA_ETH_STATIC_IP=""
CONFIG_SEDONA_ETH_GATEWAY=""
CONFIG_SEDONA_ETH_NETMASK="255.255.255.0"

CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.p4.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
