** PWM setpoint in engineering volts; 0-10 V requires a filter and amplifier.
** Two channels share a fixed 10 kHz / 12-bit timer.
class PwmOutput extends Component
{
  @config property int pin = -1
  @config property int channel = 0
  @config property bool enabled = false
  @config property float fullScale = 10.0
  property float in = 0.0
  @readonly property float out = 0.0
  @readonly property int duty = 0
  @readonly property int fault = -6
  internal int activePin = -1
  internal int activeChannel = -1
  override virtual void execute()
  {
    if (!enabled || activePin != pin || activeChannel != channel) {
      close(this, activePin, activeChannel); activePin = -1; activeChannel = -1
    }
    if (!enabled) { out := 0.0; duty := 0; fault := -6; return }
    if (in == null || fullScale == null || fullScale <= 0.0) { stop(); fault := -8; return }
    float value = in
    if (value < 0.0) value = 0.0
    if (value > fullScale) value = fullScale
    int ticks = (int)(value / fullScale * 4095.0)
    fault := write(this, pin, channel, ticks)
    if (fault != 0) { out := 0.0; duty := 0; return }
    activePin = pin; activeChannel = channel
    out := value; duty := ticks
  }
  override virtual void stop() {
    close(this, activePin, activeChannel); activePin = -1; activeChannel = -1
    out := 0.0; duty := 0; fault := -6
  }
  internal static native int write(PwmOutput owner, int pin, int channel, int duty)
  internal static native void close(PwmOutput owner, int pin, int channel)
}
